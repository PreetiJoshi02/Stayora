<% if (success && success.length) { %>
  <div class="alert alert-glass-success alert-dismissible fade show col-12 col-md-6 offset-md-3 my-3 rounded-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-circle-check fs-5 me-2" style="color: #6ce59e;"></i>
      <div><%= success %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-glass-danger alert-dismissible fade show col-12 col-md-6 offset-md-3 my-3 rounded-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-triangle-exclamation fs-5 me-2" style="color: #f78b8b;"></i>
      <div><%= error %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
