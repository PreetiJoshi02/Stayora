<% layout("/layouts/boilerplate") %>

<div class="row my-4">
  <div class="col-12 col-md-8 col-lg-7 mx-auto">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-house-chimney-medical me-2" style="color: var(--accent-terracotta);"></i>List a New Nature Stay</h3>
        <p class="text-muted small">Share your unique architectural villa, cabin, or eco-retreat with mindful travelers</p>
      </div>

      <form method="POST" action="/listings" novalidate class="needs-validation">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Property Title</label>
          <input
            id="title"
            name="listing[title]"
            placeholder="e.g. Cliffside Glass Villa with Sunset Ocean View"
            type="text"
            class="form-control rounded-3"
            required
          />
          <div class="invalid-feedback">Please enter an attractive listing title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            rows="4"
            placeholder="Tell guests about your sanctuary, surrounding jungle/ocean views, architectural features..."
            class="form-control rounded-3"
            required
          ></textarea>
          <div class="invalid-feedback">Please provide a detailed description.</div>
        </div>

        <!-- Image URL -->
        <div class="mb-3">
          <label for="image" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Image URL</label>
          <input
            id="image"
            name="listing[image]"
            placeholder="https://images.unsplash.com/..."
            type="url"
            class="form-control rounded-3"
          />
          <div class="form-text small text-muted">Leave blank to use an aesthetic default nature stay photo.</div>
        </div>

        <!-- Category & Price -->
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-6">
            <label for="category" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Category</label>
            <select id="category" name="listing[category]" class="form-select rounded-3">
              <option value="Trending" selected>Trending</option>
              <option value="Beachfront">Beachfront</option>
              <option value="Iconic Cities">Iconic Cities</option>
              <option value="Mountains">Mountains</option>
              <option value="Castles">Castles</option>
              <option value="Amazing Pools">Amazing Pools</option>
              <option value="Camping">Camping</option>
              <option value="Farms">Farms</option>
              <option value="Arctic">Arctic</option>
              <option value="Luxury">Luxury</option>
              <option value="Rooms">Rooms</option>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label for="price" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Price per Night (₹)</label>
            <div class="input-group">
              <span class="input-group-text rounded-start-3" style="color: var(--accent-gold);">₹</span>
              <input
                id="price"
                name="listing[price]"
                placeholder="4500"
                type="number"
                min="0"
                class="form-control rounded-end-3"
                required
              />
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>
          </div>
        </div>

        <!-- Location & Country -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-6">
            <label for="location" class="form-label fw-semibold small" style="color: var(--text-cream-light);">City / Location</label>
            <input
              id="location"
              name="listing[location]"
              placeholder="e.g. Bali, Ubud, Amalfi Coast, Goa"
              type="text"
              class="form-control rounded-3"
              required
            />
            <div class="invalid-feedback">Please enter location.</div>
          </div>

          <div class="col-12 col-md-6">
            <label for="country" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Country</label>
            <input
              id="country"
              name="listing[country]"
              placeholder="e.g. Indonesia, Italy, India"
              type="text"
              class="form-control rounded-3"
              required
            />
            <div class="invalid-feedback">Please enter country.</div>
          </div>
        </div>

        <!-- Amenities -->
        <div class="mb-4">
          <label class="form-label fw-semibold small d-block" style="color: var(--text-cream-light);">Available Amenities</label>
          <div class="row g-2">
            <% const popularAmenities = ['Wifi', 'Kitchen', 'Air conditioning', 'Free parking', 'Dedicated workspace', 'Pool', 'TV', 'Hot tub']; %>
            <% for (let a of popularAmenities) { %>
              <div class="col-6 col-sm-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="amenity_<%= a %>" <%= ['Wifi', 'Air conditioning', 'Kitchen', 'Free parking'].includes(a) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="amenity_<%= a %>" style="color: var(--text-cream-main);"><%= a %></label>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="d-flex gap-3">
          <button type="submit" class="btn btn-terracotta py-2 px-4 rounded-pill fw-bold">
            Publish Retreat
          </button>
          <a href="/listings" class="btn btn-glass py-2 px-4 rounded-pill">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
