<% layout("/layouts/boilerplate") %>

<div class="row my-4">
  <div class="col-12 col-xl-10 mx-auto">
    <!-- Listing Header -->
    <div class="mb-4">
      <h2 class="fw-bold mb-2" style="color: var(--text-cream-light); font-size: 2.25rem;"><%= listing.title %></h2>
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
        <div class="d-flex align-items-center gap-2 flex-wrap" style="color: var(--text-cream-muted);">
          <span><i class="fa-solid fa-star me-1" style="color: var(--accent-gold);"></i><strong style="color: var(--text-cream-light);"><%= listing.reviews && listing.reviews.length ? (4.5 + (listing.reviews.length % 5) * 0.1).toFixed(1) : 'New' %></strong></span>
          <span>•</span>
          <span class="text-decoration-underline"><%= listing.reviews ? listing.reviews.length : 0 %> review<%= listing.reviews && listing.reviews.length === 1 ? '' : 's' %></span>
          <span>•</span>
          <span><i class="fa-solid fa-location-dot me-1" style="color: var(--accent-terracotta);"></i><%= listing.location %>, <%= listing.country %></span>
        </div>
        <div>
          <span class="badge category-badge-luxury px-3 py-2 rounded-pill">
            <i class="fa-solid fa-tag me-1" style="color: var(--accent-amber);"></i> <%= listing.category || 'Trending' %>
          </span>
        </div>
      </div>
    </div>

    <!-- Image Hero -->
    <div class="show-hero-container mb-4 position-relative">
      <img
        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b' %>"
        class="img-fluid w-100 show-hero-img"
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Main Content & Reservation Split Layout -->
    <div class="row g-5">
      <!-- Left Column: Details, Amenities, Host, Reviews -->
      <div class="col-12 col-lg-7">
        <!-- Host Details -->
        <div class="d-flex justify-content-between align-items-center pb-4" style="border-bottom: 1px solid var(--border-glass);">
          <div>
            <h4 class="fw-bold mb-1">
              Entire villa hosted by <%= listing.owner ? listing.owner.username : 'Stayora Host' %>
            </h4>
            <p class="text-muted small mb-0">Luxury Eco-Host • Dedicated workspace • Private sanctuary</p>
          </div>
          <div class="host-avatar-luxury rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 flex-shrink-0" style="width: 54px; height: 54px;">
            <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
          </div>
        </div>

        <!-- Description -->
        <div class="py-4" style="border-bottom: 1px solid var(--border-glass);">
          <h5 class="fw-bold mb-3" style="color: var(--text-cream-light);">About this sanctuary</h5>
          <p class="lh-lg mb-0" style="white-space: pre-line; color: var(--text-cream-main);"><%= listing.description %></p>
        </div>

        <!-- Amenities -->
        <div class="py-4" style="border-bottom: 1px solid var(--border-glass);">
          <h5 class="fw-bold mb-3" style="color: var(--text-cream-light);">What this place offers</h5>
          <div class="row g-3">
            <% const defaultAmenities = listing.amenities && listing.amenities.length ? listing.amenities : ['Wifi', 'Kitchen', 'Air conditioning', 'Free parking', 'Dedicated workspace', 'TV']; %>
            <% for (let item of defaultAmenities) { %>
              <div class="col-6 col-md-4">
                <div class="d-flex align-items-center gap-2" style="color: var(--text-cream-main);">
                  <i class="fa-solid fa-leaf fs-6" style="color: var(--accent-sage);"></i>
                  <span><%= item %></span>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Owner Action Controls -->
        <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
          <div class="py-4" style="border-bottom: 1px solid var(--border-glass);">
            <h5 class="fw-bold mb-3" style="color: var(--accent-amber);">Host Management Controls</h5>
            <div class="d-flex gap-3 flex-wrap">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-glass rounded-pill px-4 py-2">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
              </a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing permanently? This cannot be undone.');">
                <button class="btn btn-outline-danger rounded-pill px-4 py-2">
                  <i class="fa-solid fa-trash me-1"></i> Delete Listing
                </button>
              </form>
            </div>
          </div>
        <% } %>

        <!-- Reviews Section -->
        <div class="py-4">
          <div class="d-flex align-items-center gap-2 mb-4">
            <h4 class="fw-bold mb-0">Guest Experiences</h4>
            <span class="badge category-badge-luxury rounded-pill px-3 py-1">
              <%= listing.reviews ? listing.reviews.length : 0 %>
            </span>
          </div>

          <!-- Leave Review Form -->
          <% if (currUser) { %>
            <div class="card glass-card p-4 rounded-4 mb-4">
              <h5 class="fw-bold mb-3">Leave a Review</h5>
              <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                  <label for="rating" class="form-label fw-semibold small">Rating: <span id="ratingDisplay" style="color: var(--accent-gold);">5</span> Stars</label>
                  <input
                    type="range"
                    id="rating"
                    name="review[rating]"
                    min="1"
                    max="5"
                    step="1"
                    value="5"
                    class="form-range"
                    oninput="document.getElementById('ratingDisplay').innerText = this.value"
                  />
                  <div class="d-flex justify-content-between text-muted small px-1">
                    <span>1 (Poor)</span>
                    <span>2</span>
                    <span>3 (Good)</span>
                    <span>4</span>
                    <span>5 (Amazing)</span>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="comment" class="form-label fw-semibold small">Your Experience</label>
                  <textarea
                    id="comment"
                    name="review[comment]"
                    rows="3"
                    class="form-control rounded-3"
                    placeholder="Describe the peaceful ambiance, hospitality, surroundings..."
                    required
                  ></textarea>
                  <div class="invalid-feedback">Please provide a review comment.</div>
                </div>

                <button type="submit" class="btn btn-terracotta rounded-pill px-4 py-2">
                  Submit Review
                </button>
              </form>
            </div>
          <% } else { %>
            <div class="alert alert-glass-info border rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span class="small text-muted">Want to share your experience? Log in to leave a review.</span>
              <a href="/login" class="btn btn-glass btn-sm rounded-pill px-3">Log in</a>
            </div>
          <% } %>

          <!-- Reviews Grid -->
          <% if (!listing.reviews || listing.reviews.length === 0) { %>
            <p class="text-muted small">No reviews yet. Be the first guest to share your impressions of this retreat!</p>
          <% } else { %>
            <div class="row g-3">
              <% for (let review of listing.reviews) { %>
                <div class="col-12 col-md-6">
                  <div class="card h-100 p-3 review-card-luxury">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <div class="user-avatar-custom rounded-circle d-flex align-items-center justify-content-center fw-bold small">
                          <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                          <h6 class="fw-bold mb-0 small" style="color: var(--text-cream-light);"><%= review.author ? review.author.username : 'Guest' %></h6>
                          <span class="text-muted" style="font-size: 0.75rem;">
                            <%= new Date(review.createdAt).toLocaleDateString("en-IN", { month: "short", year: "numeric" }) %>
                          </span>
                        </div>
                      </div>

                      <div class="small" style="color: var(--accent-gold);">
                        <% for (let s = 1; s <= 5; s++) { %>
                          <% if (s <= review.rating) { %>
                            <i class="fa-solid fa-star"></i>
                          <% } else { %>
                            <i class="fa-regular fa-star" style="opacity: 0.4;"></i>
                          <% } %>
                        <% } %>
                      </div>
                    </div>

                    <p class="small mb-3" style="color: var(--text-cream-main);"><%= review.comment %></p>

                    <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mt-auto pt-2" style="border-top: 1px solid var(--border-glass);">
                        <button class="btn btn-link text-danger text-decoration-none p-0 small">
                          <i class="fa-solid fa-trash-can me-1"></i> Delete
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Column: Reservation Widget -->
      <div class="col-12 col-lg-5">
        <div class="card p-4 reservation-card-luxury sticky-top" style="top: 6.5rem;">
          <div class="d-flex justify-content-between align-items-baseline mb-4">
            <div>
              <span class="fs-3 fw-bold price-tag">₹<%= (listing.price || 0).toLocaleString("en-IN") %></span>
              <span class="text-muted small"> / night</span>
            </div>
            <div class="d-flex align-items-center gap-1 small">
              <i class="fa-solid fa-star" style="color: var(--accent-gold);"></i>
              <span class="fw-semibold" style="color: var(--text-cream-light);"><%= listing.reviews && listing.reviews.length ? (4.5 + (listing.reviews.length % 5) * 0.1).toFixed(1) : 'New' %></span>
              <span class="text-muted">• <%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
            </div>
          </div>

          <!-- Reservation Form -->
          <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm" class="needs-validation" novalidate>
            <div class="reservation-date-box mb-3">
              <div class="row g-0">
                <div class="col-6 p-2" style="border-right: 1px solid var(--border-glass); border-bottom: 1px solid var(--border-glass);">
                  <label for="checkIn" class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">CHECK-IN</label>
                  <input
                    type="date"
                    id="checkIn"
                    name="booking[checkIn]"
                    class="form-control border-0 p-0 shadow-none small fw-semibold"
                    min="<%= new Date().toISOString().split('T')[0] %>"
                    required
                  />
                </div>
                <div class="col-6 p-2" style="border-bottom: 1px solid var(--border-glass);">
                  <label for="checkOut" class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">CHECKOUT</label>
                  <input
                    type="date"
                    id="checkOut"
                    name="booking[checkOut]"
                    class="form-control border-0 p-0 shadow-none small fw-semibold"
                    min="<%= new Date().toISOString().split('T')[0] %>"
                    required
                  />
                </div>
              </div>
              <div class="p-2">
                <label for="guests" class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">GUESTS</label>
                <select id="guests" name="booking[guests]" class="form-select border-0 p-0 shadow-none small fw-semibold">
                  <option value="1">1 guest</option>
                  <option value="2">2 guests</option>
                  <option value="3">3 guests</option>
                  <option value="4">4 guests</option>
                  <option value="5">5+ guests</option>
                </select>
              </div>
            </div>

            <% if (currUser) { %>
              <button type="submit" class="btn w-100 py-3 rounded-3 btn-reserve-luxury mb-3">
                Reserve Retreat
              </button>
            <% } else { %>
              <a href="/login" class="btn w-100 py-3 rounded-3 btn-reserve-luxury mb-3 text-center d-block">
                Log in to Reserve
              </a>
            <% } %>

            <p class="text-center text-muted small mb-3">You won't be charged yet</p>

            <!-- Pricing Breakdown -->
            <div id="priceBreakdown" class="small d-none">
              <div class="d-flex justify-content-between py-1" style="color: var(--text-cream-main);">
                <span>₹<%= (listing.price || 0).toLocaleString("en-IN") %> × <span id="nightsCount">1</span> night(s)</span>
                <span id="baseSubtotal">₹0</span>
              </div>
              <div class="d-flex justify-content-between py-1" style="color: var(--text-cream-main);">
                <span>Cleaning & service fee</span>
                <span>₹500</span>
              </div>
              <div class="d-flex justify-content-between py-1" style="color: var(--text-cream-main);">
                <span>GST (18%)</span>
                <span id="gstAmount">₹0</span>
              </div>
              <hr class="my-2" style="border-color: var(--border-glass);">
              <div class="d-flex justify-content-between fw-bold fs-6 pt-1" style="color: var(--text-cream-light);">
                <span>Total</span>
                <span id="totalDisplay" style="color: var(--accent-amber);">₹0</span>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Dynamic calculation for booking widget
  const pricePerNight = <%= listing.price || 0 %>;
  const checkInInput = document.getElementById('checkIn');
  const checkOutInput = document.getElementById('checkOut');
  const breakdown = document.getElementById('priceBreakdown');
  const nightsCount = document.getElementById('nightsCount');
  const baseSubtotal = document.getElementById('baseSubtotal');
  const gstAmount = document.getElementById('gstAmount');
  const totalDisplay = document.getElementById('totalDisplay');

  function calculatePrice() {
    if (!checkInInput.value || !checkOutInput.value) return;
    const start = new Date(checkInInput.value);
    const end = new Date(checkOutInput.value);
    const diff = end - start;
    const nights = Math.ceil(diff / (1000 * 60 * 60 * 24));

    if (nights > 0) {
      breakdown.classList.remove('d-none');
      nightsCount.innerText = nights;
      const sub = pricePerNight * nights;
      const gst = Math.round(sub * 0.18);
      const total = sub + 500 + gst;
      baseSubtotal.innerText = '₹' + sub.toLocaleString('en-IN');
      gstAmount.innerText = '₹' + gst.toLocaleString('en-IN');
      totalDisplay.innerText = '₹' + total.toLocaleString('en-IN');
    } else {
      breakdown.classList.add('d-none');
    }
  }

  checkInInput.addEventListener('change', () => {
    checkOutInput.min = checkInInput.value;
    calculatePrice();
  });
  checkOutInput.addEventListener('change', calculatePrice);
</script>
