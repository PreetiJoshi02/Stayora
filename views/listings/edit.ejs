<% layout("/layouts/boilerplate") %>

<div class="row my-4">
  <div class="col-12 col-md-8 col-lg-7 mx-auto">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square me-2" style="color: var(--accent-terracotta);"></i>Edit Your Sanctuary</h3>
        <p class="text-muted small">Update your retreat information, nightly pricing, and seasonal amenities</p>
      </div>

      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Property Title</label>
          <input
            id="title"
            name="listing[title]"
            value="<%= listing.title %>"
            type="text"
            class="form-control rounded-3"
            required
          />
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            rows="4"
            class="form-control rounded-3"
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter description.</div>
        </div>

        <!-- Image URL -->
        <div class="mb-3">
          <label for="image" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Image URL</label>
          <input
            id="image"
            name="listing[image]"
            value="<%= listing.image && listing.image.url ? listing.image.url : '' %>"
            type="url"
            class="form-control rounded-3"
          />
          <div class="form-text small text-muted">Provide a valid image URL (e.g. Unsplash).</div>
        </div>

        <!-- Category & Price -->
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-6">
            <label for="category" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Category</label>
            <select id="category" name="listing[category]" class="form-select rounded-3">
              <% const categories = ["Trending", "Beachfront", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Luxury", "Rooms"]; %>
              <% for (let c of categories) { %>
                <option value="<%= c %>" <%= listing.category === c ? 'selected' : '' %>><%= c %></option>
              <% } %>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label for="price" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Price per Night (₹)</label>
            <div class="input-group">
              <span class="input-group-text rounded-start-3" style="color: var(--accent-gold);">₹</span>
              <input
                id="price"
                name="listing[price]"
                value="<%= listing.price %>"
                type="number"
                min="0"
                class="form-control rounded-end-3"
                required
              />
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>
          </div>
        </div>

        <!-- Location & Country -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-6">
            <label for="location" class="form-label fw-semibold small" style="color: var(--text-cream-light);">City / Location</label>
            <input
              id="location"
              name="listing[location]"
              value="<%= listing.location %>"
              type="text"
              class="form-control rounded-3"
              required
            />
            <div class="invalid-feedback">Please enter location.</div>
          </div>

          <div class="col-12 col-md-6">
            <label for="country" class="form-label fw-semibold small" style="color: var(--text-cream-light);">Country</label>
            <input
              id="country"
              name="listing[country]"
              value="<%= listing.country %>"
              type="text"
              class="form-control rounded-3"
              required
            />
            <div class="invalid-feedback">Please enter country.</div>
          </div>
        </div>

        <!-- Amenities -->
        <div class="mb-4">
          <label class="form-label fw-semibold small d-block" style="color: var(--text-cream-light);">Available Amenities</label>
          <div class="row g-2">
            <% const allAmenities = ['Wifi', 'Kitchen', 'Air conditioning', 'Free parking', 'Dedicated workspace', 'Pool', 'TV', 'Hot tub']; %>
            <% for (let a of allAmenities) { %>
              <div class="col-6 col-sm-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="amenity_<%= a %>" <%= (listing.amenities && listing.amenities.includes(a)) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="amenity_<%= a %>" style="color: var(--text-cream-main);"><%= a %></label>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="d-flex gap-3">
          <button type="submit" class="btn btn-terracotta py-2 px-4 rounded-pill fw-bold">
            Save Changes
          </button>
          <a href="/listings/<%= listing._id %>" class="btn btn-glass py-2 px-4 rounded-pill">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
