<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-compass fs-3" style="color: var(--accent-terracotta);"></i>
        <h2 class="fw-bold mb-0">About Stayora</h2>
      </div>
      <p class="text-muted small">Curating India's most extraordinary luxury nature escapes and boutique stays.</p>
      <hr style="border-color: var(--border-glass);">
      
      <h5 class="fw-bold text-cream-light mt-3">Our Mission</h5>
      <p class="text-cream-muted">Stayora was founded with a singular vision: to bridge conscious travelers with authentic, architecturally unique, and serene boutique properties across India. From cliffside villas in Ashvem to tea estate bungalows in Munnar and royal havelis in Udaipur, we celebrate authentic regional hospitality and nature immersion.</p>
      
      <h5 class="fw-bold text-cream-light mt-4">Why Stayora?</h5>
      <ul class="text-cream-muted small mb-4">
        <li class="mb-2"><strong>Handpicked Authenticity:</strong> Every property is verified for architectural elegance, pristine natural surroundings, and exceptional host care.</li>
        <li class="mb-2"><strong>Pan-India Footprint:</strong> Covering coastal sanctuaries, Himalayan chalets, royal desert forts, and lush rainforest treehouses.</li>
        <li class="mb-2"><strong>Direct Host Connection:</strong> Transparent pricing with zero hidden fees and direct communication with verified property owners.</li>
      </ul>

      <div class="d-flex gap-2">
        <a href="/listings" class="btn btn-terracotta rounded-pill px-4">Explore Destinations</a>
        <a href="/listings/new" class="btn btn-glass rounded-pill px-4">List Your Space</a>
      </div>
    </div>
  </div>
</div>
