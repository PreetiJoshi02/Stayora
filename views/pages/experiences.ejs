<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-compass-drafting fs-3" style="color: var(--accent-terracotta);"></i>
        <h2 class="fw-bold mb-0">Curated Experiences</h2>
      </div>
      <p class="text-muted small">Immersive cultural, wellness, and adventure journeys across India.</p>
      <hr style="border-color: var(--border-glass);">
      
      <div class="row g-3 mt-2">
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-mountain-sun me-2" style="color: var(--accent-amber);"></i>High-Altitude Treks</h5>
            <p class="small text-muted mb-0">Guided snow walks and stargazing expeditions in Ladakh, Spiti, and Solang Valley.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-spa me-2" style="color: var(--accent-terracotta);"></i>Ayurvedic Wellness</h5>
            <p class="small text-muted mb-0">Traditional Kerala therapy and rainforest yoga in Wayanad and Munnar.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-monument me-2" style="color: var(--accent-gold);"></i>Royal Heritage Walks</h5>
            <p class="small text-muted mb-0">Private tours of Udaipur palaces, Jodhpur forts, and Hampi ancient ruins.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-water me-2" style="color: #64b5f6;"></i>Coastal Sunset Sailing</h5>
            <p class="small text-muted mb-0">Private catamaran cruises and backwater houseboat dining along Goa and Alleppey.</p>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <a href="/listings" class="btn btn-terracotta rounded-pill px-4 me-2">Explore Stays</a>
        <a href="/contact" class="btn btn-glass rounded-pill px-4">Contact Concierge</a>
      </div>
    </div>
  </div>
</div>
