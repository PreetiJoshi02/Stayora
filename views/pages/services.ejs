<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-bell-concierge fs-3" style="color: var(--accent-terracotta);"></i>
        <h2 class="fw-bold mb-0">Bespoke Guest Services</h2>
      </div>
      <p class="text-muted small">Elevating your luxury stay with tailored 24/7 concierge and hospitality services.</p>
      <hr style="border-color: var(--border-glass);">
      
      <div class="row g-3 mt-2">
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-utensils me-2" style="color: var(--accent-amber);"></i>Private Chef & Dining</h5>
            <p class="small text-muted mb-0">Farm-to-table culinary experiences and regional delicacies prepared in your private villa.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-car me-2" style="color: var(--accent-terracotta);"></i>Airport Transfers</h5>
            <p class="small text-muted mb-0">Seamless premium transfers, helipad coordination, and speedboats directly to your retreat.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-wifi me-2" style="color: var(--accent-gold);"></i>Remote Work Setups</h5>
            <p class="small text-muted mb-0">High-speed optic fiber connections and quiet workstation sanctuaries in nature.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);">
            <h5 class="fw-bold text-cream-light mb-1"><i class="fa-solid fa-house-chimney-user me-2" style="color: #81c784;"></i>Host Advisory</h5>
            <p class="small text-muted mb-0">End-to-end property staging, photography, and booking management for boutique stay owners.</p>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <a href="/listings" class="btn btn-terracotta rounded-pill px-4 me-2">Browse Retreats</a>
        <a href="/contact" class="btn btn-glass rounded-pill px-4">Contact Concierge</a>
      </div>
    </div>
  </div>
</div>
