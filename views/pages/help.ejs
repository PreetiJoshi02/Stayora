<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-circle-question fs-3" style="color: var(--accent-terracotta);"></i>
        <h2 class="fw-bold mb-0">Help Center & FAQs</h2>
      </div>
      <p class="text-muted small">Find quick answers to common questions about reservations, hosting, and safety.</p>
      <hr style="border-color: var(--border-glass);">
      
      <div class="accordion accordion-flush mt-3" id="helpAccordion">
        <div class="accordion-item mb-2 rounded-3 overflow-hidden" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed bg-transparent text-cream-light fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#q1">
              How do I reserve a luxury stay on Stayora?
            </button>
          </h2>
          <div id="q1" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
            <div class="accordion-body text-cream-muted small">
              Browse our curated destinations, select your desired retreat, choose your check-in and check-out dates, and click "Reserve Now". You will receive instant booking confirmation in your account.
            </div>
          </div>
        </div>

        <div class="accordion-item mb-2 rounded-3 overflow-hidden" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed bg-transparent text-cream-light fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#q2">
              How can I list my own boutique property?
            </button>
          </h2>
          <div id="q2" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
            <div class="accordion-body text-cream-muted small">
              Click "Become a host" in the top navigation bar. After logging in, submit your property details, category, authentic photography, and nightly rates to publish your listing immediately.
            </div>
          </div>
        </div>

        <div class="accordion-item mb-2 rounded-3 overflow-hidden" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed bg-transparent text-cream-light fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#q3">
              What payment methods are supported?
            </button>
          </h2>
          <div id="q3" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
            <div class="accordion-body text-cream-muted small">
              We support all major Indian and international debit/credit cards, UPI, net banking, and verified digital wallets with 256-bit encryption.
            </div>
          </div>
        </div>
      </div>

      <div class="mt-4 d-flex gap-2">
        <a href="/contact" class="btn btn-terracotta rounded-pill px-4">Contact Support</a>
        <a href="/cancellation" class="btn btn-glass rounded-pill px-4">Cancellation Policy</a>
      </div>
    </div>
  </div>
</div>
