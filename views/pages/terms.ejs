<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <h2 class="fw-bold mb-3"><i class="fa-solid fa-file-contract me-2" style="color: var(--accent-terracotta);"></i>Terms of Service</h2>
      <p class="text-muted small">Last updated: September 2026</p>
      <hr style="border-color: var(--border-glass);">
      <h5 class="fw-bold mt-3">1. Acceptance of Terms</h5>
      <p>By registering, listing accommodations, or reserving stays on Stayora, you agree to comply with our community and hosting standards.</p>
      <h5 class="fw-bold mt-3">2. Accurate Listings</h5>
      <p>Hosts must provide accurate descriptions, genuine location details, and fair nightly rates for all published properties.</p>
      <h5 class="fw-bold mt-3">3. Respect & Safety</h5>
      <p>Guests and hosts must communicate respectfully and adhere to property guidelines and cancellation terms.</p>
      <a href="/listings" class="btn btn-glass mt-3 rounded-pill px-4 align-self-start">Back to Retreats</a>
    </div>
  </div>
</div>
