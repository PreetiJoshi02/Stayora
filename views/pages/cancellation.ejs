<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-12 col-md-8 offset-md-2">
    <div class="card glass-card p-4 p-md-5 rounded-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-rotate-left fs-3" style="color: var(--accent-terracotta);"></i>
        <h2 class="fw-bold mb-0">Cancellation & Refund Policies</h2>
      </div>
      <p class="text-muted small">Clear, guest-friendly cancellation frameworks across our boutique retreats.</p>
      <hr style="border-color: var(--border-glass);">
      
      <div class="mt-3">
        <h5 class="fw-bold text-cream-light"><i class="fa-solid fa-circle-check me-2" style="color: #81c784;"></i>Flexible (Up to 48 hours before check-in)</h5>
        <p class="small text-cream-muted">Full refund for cancellations made up to 48 hours before scheduled check-in. If booked less than 48 hours before check-in, full refund for cancellations made within 24 hours of booking.</p>
        
        <h5 class="fw-bold text-cream-light mt-4"><i class="fa-solid fa-shield-halved me-2" style="color: var(--accent-amber);"></i>Moderate (Up to 5 days before check-in)</h5>
        <p class="small text-cream-muted">Full refund for cancellations made up to 5 days before check-in. For cancellations within 5 days, 50% refund minus the first night and service fee.</p>

        <h5 class="fw-bold text-cream-light mt-4"><i class="fa-solid fa-umbrella me-2" style="color: #64b5f6;"></i>Weather & Extenuating Circumstances</h5>
        <p class="small text-cream-muted">In the rare event of natural weather disruptions or official travel advisories, our concierge team assists with full date rebooking or voucher issuance.</p>
      </div>

      <div class="mt-4">
        <a href="/listings" class="btn btn-glass rounded-pill px-4 me-2">Back to Retreats</a>
        <a href="/contact" class="btn btn-terracotta rounded-pill px-4">Contact Support</a>
      </div>
    </div>
  </div>
</div>
